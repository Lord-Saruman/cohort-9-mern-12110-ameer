{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "description": "Internship Notes App — React, Node.js, and MySQL",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@notes/api\" \"npm run dev --workspace=@notes/web\"",
    "dev:api": "npm run dev --workspace=@notes/api",
    "dev:web": "npm run dev --workspace=@notes/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces && node -e \"const fs=require('fs');['apps/api','apps/web'].forEach(pkg=>{const f=pkg+'/coverage/lcov.info';if(fs.existsSync(f)){fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/\\\\/g,'/').replace(/SF:src\\//g,'SF:'+pkg+'/src/'));}});\"",
    "db:migrate": "npm run db:migrate --workspace=@notes/api",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
